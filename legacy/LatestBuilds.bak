<?php
namespace WindowsBuilds\Widget;

use XF\Widget\AbstractWidget;
use XF\Template\Templater;
use GuzzleHttp\Client;

/**
 * If a build summary is requested via AJAX using the GET parameter "build_summary_uuid",
 * output the JSON response directly and exit.
 */
if (isset($_GET['build_summary_uuid'])) {
    // Include the current file to access the LatestBuilds class.
    require_once(__DIR__ . '/LatestBuilds.php');
    $uuid = $_GET['build_summary_uuid'];
    // Use an optional build title if provided; otherwise, use a default value.
    $title = isset($_GET['build_title']) ? $_GET['build_title'] : "Windows Build " . $uuid;
    
    header('Content-Type: application/json');
    echo json_encode(['summary' => LatestBuilds::getSummaryTooltip($uuid, $title)]);
    exit;
}

class LatestBuilds extends AbstractWidget
{
    /**
     * Fetch the latest build data from the UUP Dump API cache.
     */
    private static function fetchLatestData()
    {
        $apiUrl = "https://api.uupdump.net/listid.php?sortByDate=1";
        $cacheFile = '/web/ai/json/latest_builds_cache.json';

        $client = new Client();
        try {
            $newResponse = $client->get($apiUrl);
            $newResponseBody = $newResponse->getBody()->getContents();
            $responseDecoded = json_decode($newResponseBody, true);
            $timestamp = $responseDecoded['timestamp'] ?? time();

            $cacheData = [
                'timestamp' => $timestamp,
                'response' => $responseDecoded
            ];
            file_put_contents($cacheFile, json_encode($cacheData));
            return $cacheData['response'];
        } catch (\Exception $e) {
            // Optionally log the exception.
            return null;
        }
    }

    /**
     * Fetch builds filtering by version, architecture, month, and year.
     */
    public static function fetchBuilds($version, $arch = 'amd64', $month = '', $year = '')
    {
        $cacheFile = '/web/ai/json/latest_builds_cache.json';
        $response = '';
        $debugSource = 'Cache Miss';
        $lastPullTime = time();

        if (file_exists($cacheFile)) {
            $cachedData = json_decode(file_get_contents($cacheFile), true);
            $lastPullTime = $cachedData['timestamp'] ?? time();

            // Use cache if not older than 1 hour.
            if (time() - $lastPullTime <= 3600) {
                $response = $cachedData['response'] ?? null;
                $debugSource = 'Cache Hit';
            } else {
                $response = self::fetchLatestData();
                $debugSource = 'Cache Updated';
            }
        } else {
            $response = self::fetchLatestData();
        }

        if (!$response) {
            return [
                'builds' => [],
                'lastPullTime' => $lastPullTime,
                'debugSource' => 'No Data'
            ];
        }

        $allBuilds = $response['response']['builds'] ?? [];
        $filteredBuilds = array_filter($allBuilds, function($build) use ($version, $arch, $month, $year) {
            $versionMatch = stripos($build['title'], $version) !== false;
            $archMatch = $build['arch'] === $arch;
            $monthMatch = !$month || $month === 'All' || date('F', $build['created']) === $month;
            $yearMatch = !$year || $year === 'All' || date('Y', $build['created']) === $year;
            return $versionMatch && $archMatch && $monthMatch && $yearMatch;
        });

        // Format each build and set a placeholder for the summary tooltip.
        foreach ($filteredBuilds as &$build) {
            $build['created'] = date('F j, Y', $build['created']);
            $build['month'] = date('F', strtotime($build['created']));
            $build['year'] = date('Y', strtotime($build['created']));

            // Leave the UUP Dump link unchanged.
            // Set the initial tooltip text to "Loading summary…"
            // if a UUID exists; otherwise, note that summary is not available.
            if (!empty($build['uuid'])) {
                $build['summary_tooltip'] = "Loading summary…";
            } else {
                $build['summary_tooltip'] = "Summary not available.";
            }
        }

        return [
            'builds' => $filteredBuilds,
            'lastPullTime' => $lastPullTime,
            'debugSource' => $debugSource
        ];
    }

    /**
     * Generates the AI-powered summary for a build using Redis caching and the FastAPI /responses endpoint.
     * Uses up to 3 attempts (with a 1-second delay between attempts) to avoid returning an empty summary.
     *
     * @param string $uuid  Unique build identifier.
     * @param string $title Build title.
     * @return string       Summary text.
     */
    public static function getSummaryTooltip($uuid, $title)
    {
        // Connect to Redis.
        $redis = new \Redis();
        $redis->connect('127.0.0.1', 6379);
        $cacheKey = "windowsbuild_summary:" . $uuid;

        // Check if the summary is cached.
        $cached = $redis->get($cacheKey);
        if ($cached !== false) {
            return $cached;
        }

        // Prepare the payload for the FastAPI /responses endpoint.
        $payload = json_encode([
            "message" => [
                "user" => "Summarize the Windows build titled '{$title}' in 1–2 sentences. Include key changes, features, or bug fixes in plain English."
            ],
            "model" => "gpt-4o-mini",
            "stream" => false,
            "disable_all_tools" => 0,
            "file_search_enabled" => 1,
            "web_search_preview_enabled" => 1,
            "instructions" => "Be concise and informative. Do not include extraneous details or version numbers."
        ]);

        $summary = "";
        $attempts = 0;
        // Try up to 3 times to fetch a nonempty summary.
        while ($attempts < 3) {
            $ch = curl_init("http://127.0.0.1:8001/openai/responses");
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_POSTFIELDS, $payload);
            curl_setopt($ch, CURLOPT_HTTPHEADER, [
                'Content-Type: application/json'
            ]);
            $response = curl_exec($ch);
            curl_close($ch);

            if ($response) {
                $json = json_decode($response, true);
                if (isset($json['final_output'])) {
                    $summary = trim($json['final_output']);
                }
            }

            if (!empty($summary)) {
                break;
            }
            $attempts++;
            sleep(1);
        }

        // If still empty after retries, use a fallback message.
        if (empty($summary)) {
            $summary = "Summary could not be loaded at this time.";
        }

        // Cache the summary in Redis for 90 days.
        $ninetyDaysInSeconds = 90 * 24 * 60 * 60; // 7776000 seconds
        $redis->setex($cacheKey, $ninetyDaysInSeconds, $summary);

        return $summary;
    }

    /**
     * Returns an array of month options.
     */
    private static function getMonths($year)
    {
        $months = [
            'All', 'January', 'February', 'March', 'April', 'May', 'June',
            'July', 'August', 'September', 'October', 'November', 'December'
        ];

        $currentYear = date('Y');
        $currentMonth = date('F');

        if ($year == $currentYear) {
            $futureMonths = array_slice($months, array_search($currentMonth, $months) + 1);
            return array_diff($months, $futureMonths);
        }
        return $months;
    }

    /**
     * Returns an array of years (with "All" as the first option).
     */
    private static function getYears()
    {
        $currentYear = date('Y');
        $years = ['All'];
        for ($i = 0; $i < 10; $i++) {
            $years[] = $currentYear - $i;
        }
        return $years;
    }

    /**
     * Renders the widget output.
     */
    public function render(array $options = [], $templateName = 'public:widget_latest_builds', $displayContext = null)
    {
        $request = \XF::app()->request();
        $selectedMonth = $request->filter('selectedMonth', 'str', date('F'));
        $selectedYear = $request->filter('selectedYear', 'str', date('Y'));
        $selectedArch = $request->filter('selectedArch', 'str', 'amd64');
        $selectedTab = $request->filter('tab', 'str', 'windows11'); // Default tab

        $windows11Data = self::fetchBuilds('Windows 11', $selectedArch, $selectedMonth, $selectedYear);
        $windows10Data = self::fetchBuilds('Windows 10', $selectedArch, $selectedMonth, $selectedYear);
        $windowsServerData = self::fetchBuilds('Windows Server', $selectedArch, $selectedMonth, $selectedYear);

        /** @var Templater $templater */
        $templater = \XF::app()->templater();
        return $templater->renderTemplate($templateName, [
            'windows11Builds' => $windows11Data['builds'],
            'windows10Builds' => $windows10Data['builds'],
            'windowsServerBuilds' => $windowsServerData['builds'],
            'lastPullTime' => max($windows11Data['lastPullTime'], $windows10Data['lastPullTime'], $windowsServerData['lastPullTime']),
            'months' => self::getMonths($selectedYear),
            'years' => self::getYears(),
            'selectedMonth' => $selectedMonth,
            'selectedYear' => $selectedYear,
            'selectedArch' => $selectedArch,
            'selectedTab' => $selectedTab,
            'debugSource' => $windows11Data['debugSource']
        ]);
    }

    /**
     * Helper to render this widget statically.
     */
    public static function renderStatic(\XF\Widget\PhpCallback $widget, $templateName = 'public:widget_latest_builds', $displayContext = null)
    {
        $app = $widget->app;
        $widgetConfig = $widget->widgetConfig;
        $instance = new self($app, $widgetConfig);
        return $instance->render($widget->options, $templateName, $displayContext);
    }
}
