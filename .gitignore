# The repo root ignores `*.json` wholesale (see /web/.gitignore). Without these
# negations the manifests that define this app are untracked, and a fresh clone
# cannot install or type-check it. The parent directory is not itself excluded,
# so re-inclusion here is honoured by git.
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!.oxlintrc.json
!xenforo-addon/**/*.json
!xenforo-addon/CLAUDE.md

# Local production/debug artifacts
.env.production
.playwright-mcp/

# Local deployment helpers (kept outside the public source tree)
CLAUDE.md
build-and-update.sh
start.sh
update-controller.sh
